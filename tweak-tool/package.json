{
  "name": "attack-tweaks",
  "productName": "Attack.tweaks",
  "version": "1.0.0",
  "description": "Windows Gaming Tweak Panel",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.attack.tweaks",
    "productName": "Attack.tweaks",
    "files": ["main.js", "tweaks.js", "fixes.js", "preload.js", "license.js", "license-config.json", "renderer/**"],
    "win": {
      "target": "portable",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "portable": { "artifactName": "Attack-tweaks.exe" },
    "directories": { "output": "dist" }
  }
}
